{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_UMBRACULUM_MODULE_PROFILE": "reference"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://demo.umbraculum.dev",
        "EXPO_PUBLIC_MEDIA_BASE_URL": "https://demo.umbraculum.dev",
        "EXPO_PUBLIC_UMBRACULUM_MODULE_PROFILE": "reference"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_UMBRACULUM_MODULE_PROFILE": "reference"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
