{
  "name": "@umbraculum/native-brewery",
  "private": true,
  "version": "0.0.1",
  "description": "Umbraculum native app \u2014 Expo + React Native mobile client for the brewery vertical, sharing UI primitives and recipe editors with the web app via @umbraculum/{ui, brewery-recipes-ui, \u2026}. Application workspace; not imported by other workspaces.",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "i18n:guardrail": "node scripts/i18n-guardrail.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@react-navigation/bottom-tabs": "^7.15.0",
    "@react-navigation/native": "^7.1.29",
    "@react-navigation/native-stack": "^7.14.0",
    "@tamagui/core": "3.2.0",
    "@umbraculum/api-client": "^0.0.3",
    "@umbraculum/brewery-api-client": "file:../../../packages/verticals/brewery/api-client",
    "@umbraculum/brewery-beerjson": "file:../../../packages/verticals/brewery/beerjson",
    "@umbraculum/brewery-contracts": "file:../../../packages/verticals/brewery/contracts",
    "@umbraculum/brewery-media-assets": "file:../../../packages/verticals/brewery/media-assets",
    "@umbraculum/brewery-recipes-ui": "file:../../../packages/verticals/brewery/recipes-ui",
    "@umbraculum/contracts": "^0.0.1",
    "@umbraculum/i18n": "file:../../../packages/platform/i18n",
    "@umbraculum/i18n-react": "file:../../../packages/platform/i18n-react",
    "@umbraculum/media": "file:../../../packages/platform/media",
    "@umbraculum/module-sdk": "file:../../../packages/sdk/module-sdk",
    "@umbraculum/native-shell": "file:../../../packages/platform/native-shell",
    "@umbraculum/navigation": "file:../../../packages/platform/navigation",
    "@umbraculum/ui": "file:../../../packages/platform/ui",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-image": "~58.0.18",
    "expo-localization": "~58.0.5",
    "expo-secure-store": "~58.0.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "tamagui": "3.2.0",
